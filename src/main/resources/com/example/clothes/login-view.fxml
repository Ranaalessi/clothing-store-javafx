<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Pos?>
<?import javafx.scene.text.Font?>

<AnchorPane xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.clothes.LoginController">
    <!-- خلفية -->
    <AnchorPane style="-fx-background-color: #0077B6;" prefWidth="400" prefHeight="600">
        <!-- عنوان -->
        <Label text="تسجيل حساب" style="-fx-font-size: 24px; -fx-text-fill: white;" layoutX="130" layoutY="50" />

        <!-- حقل اسم المستخدم -->
        <Label text="اسم المستخدم" style="-fx-font-size: 14px; -fx-text-fill: white;" layoutX="50" layoutY="150"/>
        <TextField fx:id="usernameField" layoutX="50" layoutY="180" prefWidth="300"/>

        <!-- حقل البريد الإلكتروني -->
        <Label text="البريد الإلكتروني" style="-fx-font-size: 14px; -fx-text-fill: white;" layoutX="50" layoutY="220"/>
        <TextField fx:id="emailField" layoutX="50" layoutY="250" prefWidth="300"/>

        <!-- حقل كلمة المرور -->
        <Label text="كلمة المرور" style="-fx-font-size: 14px; -fx-text-fill: white;" layoutX="50" layoutY="290"/>
        <PasswordField fx:id="passwordField" layoutX="50" layoutY="320" prefWidth="300"/>

        <!-- زر التسجيل -->
        <Button text="تسجيل" style="-fx-background-color: #00B4D8; -fx-text-fill: white; -fx-font-size: 16px;" layoutX="150" layoutY="380" prefWidth="100" onAction="#handleRegister"/>

        <!-- رابط لتسجيل الدخول -->
        <Hyperlink text="هل لديك حساب؟ تسجيل الدخول" layoutX="120" layoutY="450" style="-fx-text-fill: white;" onAction="#handleLoginRedirect"/>
    </AnchorPane>
</AnchorPane>